# ===== 数据构建 =====
# false = 完全不输出 mock 数据（活动正式开始前切换）
SHOW_MOCK=true

# ===== 可选：将来接真 Piston 时用（当前零后端，不生效） =====
# PISTON_URL=http://localhost:2000
# VITE_API_BASE=/api

# ===== Pyodide =====
# 运行时版本固定在 client/public/py.worker.js 的 PYODIDE_VERSION（v0.28.3）
# 若校园网访问 jsdelivr 不稳定，可改为自托管，见 README「Pyodide 自托管」
